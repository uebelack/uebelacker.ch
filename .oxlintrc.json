{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "react", "nextjs"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "react/react-in-jsx-scope": "off",
    // These three come from the React Compiler's rule set. The old ESLint setup
    // never ran them and the project does not use the compiler; adopting them
    // means reworking components, which is its own change.
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/immutability": "off"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "vitest.setup.js"],
      "plugins": ["vitest"],
      "env": {
        "vitest": true
      }
    }
  ],
  "ignorePatterns": [".next/**", "coverage/**", "public/**"]
}
